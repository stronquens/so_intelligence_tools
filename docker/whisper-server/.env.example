WHISPER_MODEL=large-v3-turbo
WHISPER_LANGUAGE=es
WHISPER_PORT=9000
WHISPER_IMAGE=hwdsl2/whisper-server:latest
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM=1
WHISPER_STARTUP_TIMEOUT_SECONDS=300
# Keep the localhost-only development server open. Recent hwdsl2/whisper-server
# images autogenerate an API key when this variable is absent on a fresh volume.
WHISPER_API_KEY=
